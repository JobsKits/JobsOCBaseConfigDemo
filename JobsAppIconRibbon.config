# 原始 AppIcon，只读；生成器不会修改这里的任何文件。
SOURCE_APPICONSET=JobsOCBaseConfigDemo/其他/libs/图片资源文件/xcassets/Assets.xcassets/AppIcon.appiconset
OUTPUT_NAME_PREFIX=JobsAppIconRibbon

# 留空 RIBBON_TEXT 时，Debug / Release 自动使用下面的环境文案。
RIBBON_TEXT=
DEBUG_TEXT=DEBUG
RELEASE_TEXT=RELEASE

# 绶带默认棕色、文字默认白色；颜色支持 #RRGGBB / #RRGGBBAA。
BACKGROUND_COLOR=#8B4513
TEXT_COLOR=#FFFFFF

# 使用 macOS 字体名称；找不到时自动回退到系统粗体。
FONT_NAME=HelveticaNeue-Bold
FONT_SIZE_RATIO=0.105
