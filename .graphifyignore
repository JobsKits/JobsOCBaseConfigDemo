Pods/**/*.svg
Pods/**/*.pdf
Pods/**/*.doc
Pods/**/*.docx
Pods/**/*.xls
Pods/**/*.xlsx
Pods/**/*.ppt
Pods/**/*.pptx
Pods/**/*.mp4
Pods/**/*.mov
Pods/**/*.json
Pods/**/*.plist
Pods/**/*.storyboard
Pods/**/*.xib
Pods/**/*.xcassets/**
Pods/**/Assets/**
Pods/**/Resources/**
Pods/**/*.bundle/**
