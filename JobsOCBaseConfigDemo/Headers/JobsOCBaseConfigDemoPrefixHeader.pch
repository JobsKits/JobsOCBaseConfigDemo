#ifndef JobsOCBaseConfigPrefixHeader_pch
#define JobsOCBaseConfigPrefixHeader_pch
#pragma mark —— 系统 SDK
#import <arpa/inet.h>                                       // 提供网络地址转换函数，如 IP 地址在字符串与二进制格式之间转换。
#import <AVFoundation/AVFoundation.h>                       // 提供音视频采集、播放、编辑与处理能力，如媒体资源加载、缩略图提取、音频混合等。
#import <AppTrackingTransparency/AppTrackingTransparency.h> // 提供 App Tracking Transparency 权限请求能力，用于获取用户是否允许跨 App / 网站追踪。
#import <AdSupport/AdSupport.h>                             // 提供广告标识符 IDFA 访问能力，通常需结合 ATT 授权状态判断是否可用。
#import <AudioToolbox/AudioToolbox.h>                       // 用于调用系统级音频能力。
#import <CoreMotion/CoreMotion.h>                           // 用于访问设备运动传感器数据：加速度计、陀螺仪、磁力计、设备姿态、计步器等。
#import <CommonCrypto/CommonDigest.h>                       // 提供常见摘要算法接口，如 MD5、SHA1、SHA256 等。
#import <CoreData/CoreData.h>                               // 提供对象图管理与本地持久化能力，用于数据建模、存储和查询。
#import <CoreGraphics/CoreGraphics.h>                       // 提供二维图形绘制能力，如点、尺寸、矩形、路径、上下文等图形基础结构。
#import <CoreImage/CoreImage.h>                             // 提供图像处理能力，如滤镜、特效、颜色调整和图像合成。
#import <CoreTelephony/CTCarrier.h>                         // 提供运营商信息，如运营商名称、国家码、网络码等。
#import <CoreTelephony/CTTelephonyNetworkInfo.h>            // 提供蜂窝网络相关信息，如网络制式、运营商变化等状态。
#import <CoreText/CoreText.h>                               // 提供底层文本排版与渲染能力，适合富文本、复杂排版和精细文本控制场景。
#import <EventKit/EventKit.h>                               // 提供系统日历与提醒事项访问能力，可读取、创建和修改事件。
#import <Foundation/Foundation.h>                           // 提供 Objective-C 基础类型、集合类、运行时基础能力和常用工具类。
#import <ifaddrs.h>                                         // 提供网络接口地址遍历能力，可获取设备各网络接口的 IP 地址等信息。
#import <ImageIO/ImageIO.h>                                 // 提供图像编解码能力，支持多种图片格式的读取、写入和元数据处理。
#import <Intents/Intents.h>                                 // 提供 Intents 框架能力，用于 Siri、快捷指令、意图捐赠、意图处理及相关扩展开发。
#import <JavaScriptCore/JavaScriptCore.h>                   // 提供 Objective-C / Swift 与 JavaScript 交互能力，可执行脚本并进行对象桥接。
#import <LocalAuthentication/LocalAuthentication.h>         // 提供本地身份认证能力，如 Face ID、Touch ID 和设备密码校验。
#import <mach/mach.h>                                       // 提供 Mach 层底层系统能力，可访问任务、线程、内存、CPU 等系统信息。
#import <MapKit/MapKit.h>                                   // 提供地图展示、地理位置标注、路线与区域处理等地图服务能力。
#import <net/if.h>                                          // 定义网络接口相关常量、结构体和操作接口。
#import <net/if_var.h>                                      // 引入网络接口内部状态、统计信息及相关内核结构定义
#import <net/if_dl.h>                                       // 提供链路层网络接口信息，常用于获取 MAC 地址等底层数据。
#import <objc/NSObjCRuntime.h>                              // 提供 Objective-C 运行时的基础宏、类型定义与平台兼容能力。
#import <objc/message.h>                                    // 引入 Objective-C 运行时消息发送相关函数与类型定义。
#import <objc/runtime.h>                                    // 提供 Objective-C 运行时操作能力，可用于动态添加方法、交换实现、关联对象等。
#import <os/lock.h>                                         // 提供系统级高性能锁，如 os_unfair_lock，适合轻量级同步场景。
#import <PDFKit/PDFKit.h>                                   // 提供 PDF 文档的读取、渲染、标注和交互能力。
#import <Photos/Photos.h>                                   // 提供系统相册访问能力，可读取和管理照片、视频等媒体资源。
#import <pthread.h>                                         // 提供 POSIX 线程接口，用于底层多线程控制、线程同步和并发处理。
#import <QuartzCore/QuartzCore.h>                           // 提供 Core Animation 和 CALayer 能力，用于动画、图层和视觉渲染。
#import <TargetConditionals.h>                              // 引入 Apple 平台条件判断宏，用于编译期区分 iOS、macOS、模拟器等目标环境。
#import <Security/Security.h>                               // 提供安全相关能力，如证书、密钥链、加密、签名、身份认证等。
#import <sys/sysctl.h>                                      // 提供系统与硬件信息查询接口，如内存、CPU、设备型号等信息。
#import <UIKit/UIKit.h>                                     // 提供 iOS 应用的 UI 基础设施，包括视图、控件、事件、动画和控制器体系。
#import <UserNotifications/UserNotifications.h>             // 提供本地通知和远程通知处理能力，是现代通知框架的统一入口。
#import <UniformTypeIdentifiers/UTCoreTypes.h>              // 用于识别文件/数据类型（例如：图片、视频、文本、PDF、URL 等系统标准类型）常用于文件选择、分享、拖拽、剪贴板、文档导入导出等场景
#import <VideoToolbox/VideoToolbox.h>                       // 提供视频编解码与处理能力，常用于视频解码、硬编硬解等场景。
#import <WebKit/WebKit.h>                                   // 提供网页加载、浏览器内嵌、JS 交互等 Web 内容展示能力。
#import <NetworkExtension/NetworkExtension.h>               // 用于访问系统级网络扩展能力：VPN 配置、网络代理、DNS 代理、内容过滤、热点辅助等（部分能力需要 Apple 对应 entitlement 授权，否则即使编译通过也无法正常使用。）

#import <_ctype.h>                                          // 引入字符分类与大小写转换等 C 标准字符处理相关的内部定义
#include <unistd.h>                                         // 提供 POSIX 标准系统调用接口，如 read、write、close、sleep 等。
#include <AvailabilityMacros.h>                             // 提供系统版本可用性宏，用于兼容不同 iOS / macOS 版本。

#ifdef __cplusplus
#include <vector>                                           // C++ 动态数组容器，适用于需要模板容器支持的 Objective-C++ 场景。
#include <memory>                                           // C++ 内存管理工具头，提供智能指针、分配器等能力。
#include <mutex>                                            // C++ 互斥锁与线程同步工具头。
#include <new>                                              // C++ 对象构造、placement new 和内存分配相关支持。
#include <thread>                                           // C++ 标准线程库，提供线程创建与管理能力。
#endif

