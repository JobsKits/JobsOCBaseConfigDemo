#!/bin/zsh
# hook 自述：用户提交 byPods 后更新 Gitee 快照；不推送，不切换工作区。

# 从当前 Git 工作区定位项目工具，交由工具核对分支并生成快照。
run_snapshot_hook() {
  local hook_project_root=""
  hook_project_root="$(git rev-parse --show-toplevel)" || return 1
  if [[ ! -f "$hook_project_root/ScriptsByDevTools/gitee_snapshot.command/gitee_snapshot.command" ]]; then
    [[ "$(git symbolic-ref --quiet --short HEAD)" == byPods ]] || return 0
    print -u2 -- '✖ byPods 缺少快照脚本；源提交已完成，请恢复脚本后同步快照。'
    return 1
  fi
  /bin/zsh "$hook_project_root/ScriptsByDevTools/gitee_snapshot.command/gitee_snapshot.command" --hook post-commit "$@"
}
# 编排提交后的快照更新。
main() {
  run_snapshot_hook "$@" # 从用户刚完成的提交更新 Gitee 专用提交链。
}
main "$@"
