#!/bin/zsh
# hook 自述：byPods 合并完成后更新 Gitee 快照；不推送，不合并远端历史。

# 从当前 Git 工作区定位项目工具，合并后的内容仍只作为快照树。
run_snapshot_hook() {
  local hook_project_root=""
  hook_project_root="$(git rev-parse --show-toplevel)" || return 1
  if [[ ! -f "$hook_project_root/ScriptsByDevTools/gitee_snapshot.command/gitee_snapshot.command" ]]; then
    [[ "$(git symbolic-ref --quiet --short HEAD)" == byPods ]] || return 0
    print -u2 -- '✖ byPods 缺少快照脚本；合并已完成，请恢复脚本后同步快照。'
    return 1
  fi
  /bin/zsh "$hook_project_root/ScriptsByDevTools/gitee_snapshot.command/gitee_snapshot.command" --hook post-merge "$@"
}
# 编排合并后的快照更新。
main() {
  run_snapshot_hook "$@" # 从合并完成的 byPods 文件树更新 Gitee 快照。
}
main "$@"
