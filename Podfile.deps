# Flutter框架
def flutterPods
  pod 'Flutter'
end

# 几乎每个App都会用到的
def appCommon
  pod 'Masonry'                       # https://github.com/SnapKit/Masonry
  pod 'OpenUDID'                      # https://github.com/ylechelle/OpenUDID Open source initiative for a universal and persistent UDID solution for iOS
  pod 'MJRefresh'                     # https://github.com/CoderMJLee/MJRefresh 纵向刷新
  pod 'PromiseKit'                    # https://github.com/mxcl/PromiseKit                ❤️
  pod 'FTroulette'                    # https://github.com/520coding/FTdashboad 一个仪表盘
  pod 'XZMRefresh'                    # https://github.com/xiezhongmin/XZMRefresh 横向刷新
  pod 'SDWebImage'                    # https://github.com/SDWebImage/SDWebImage
  pod 'YTKNetwork'                    # https://github.com/yuantiku/YTKNetwork
  pod "HTMLReader"                    # https://github.com/nolanw/HTMLReader 处理 HTML 语法
  pod 'MJExtension'                   # https://github.com/CoderMJLee/MJExtension
  pod 'YQImageTool'
  pod 'GBDeviceInfo'                  # https://github.com/lmirosevic/GBDeviceInfo
  pod 'AFNetworking'                  # https://github.com/AFNetworking/AFNetworking  ⚠️ 作者停止维护
  pod 'Reachability'                  # https://github.com/tonymillion/Reachability 检查联网情况
  pod 'ReactiveObjC'                  # https://github.com/ReactiveCocoa/ReactiveObjC
  pod 'SocketRocket'                  # https://github.com/facebookincubator/SocketRocket
  pod 'HXRotationTool'                # https://github.com/TheLittleBoy/HXRotationTool 屏幕旋转
  pod 'CocoaLumberjack'               # https://github.com/CocoaLumberjack/CocoaLumberjack❤️ 日志框架
  pod 'IQKeyboardManager'             # https://github.com/hackiftekhar/IQKeyboardManager Codeless drop-in universal library allows to prevent issues of keyboard sliding up and cover UITextField/UITextView. Neither need to write any code nor any setup required and much more.
  pod 'SDWebImageWebPCoder'           # https://github.com/SDWebImage/SDWebImageWebPCoder ❤️
  pod 'UITextView+Placeholder'        # https://github.com/devxoul/UITextView-Placeholder A missing placeholder for UITextView.

#  pod 'ZBNetworking', :git => 'https://github.com/Suzhibin/ZBNetworking.git' # https://github.com/Suzhibin/ZBNetworking
#  pod 'JobsBlock'              # https://github.com/JobsKit/JobsBlock
#  pod 'DeviceKit'              # https://github.com/devicekit/DeviceKit            ❤️ 设备信息/设备系列/模拟器设备识别/电池状态/低功耗模式状态/当前是否为引导式访问会话/调整屏幕亮度/可用磁盘空间
#  pod 'TABAnimated'            # https://github.com/tigerAndBull/TABAnimated
#  pod 'YYKit'                 # https://github.com/ibireme/YYKit
#  pod 'XYColorOC'              # https://github.com/RayJiang16/XYColor 适配iOS 13夜间模式/深色外观(Dark Mode)
#  pod 'SDAutoLayout'          # https://github.com/gsdios/SDAutoLayout
end
